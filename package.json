{
  "name": "@coo-quack/openclaw-cursor-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "Run Cursor's cursor-agent CLI as an OpenClaw text inference backend",
  "homepage": "https://github.com/coo-quack/openclaw-cursor-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coo-quack/openclaw-cursor-cli.git"
  },
  "license": "MIT",
  "files": [
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.0",
      "minGatewayVersion": "2026.6.0"
    }
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.0"
  }
}
