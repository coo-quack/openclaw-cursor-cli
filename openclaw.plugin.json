{
  "id": "cursor-cli",
  "name": "Cursor CLI",
  "description": "Run Cursor's cursor-agent CLI through OpenClaw as cursor-cli/<model> (text-only) and cursor-mcp/<model> (adds OpenClaw's MCP tool bridge)",
